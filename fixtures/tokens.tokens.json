{
  "$schema": "https://github.com/yschimke/design-parity/schema/dtcg-tokens.schema.json",
  "color": {
    "$type": "color",
    "primary": { "$value": "#6750A4" },
    "on-primary": { "$value": "#FFFFFF" },
    "brand": { "$value": "{color.primary}" }
  },
  "space": {
    "$type": "dimension",
    "gutter": { "$value": "16px" },
    "inset": { "$value": { "value": 8, "unit": "px" } }
  },
  "shape": {
    "$type": "dimension",
    "corner-radius": { "$value": "12px" }
  },
  "type": {
    "body-large": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Roboto",
        "fontSize": "16px",
        "fontWeight": 400,
        "lineHeight": 24,
        "letterSpacing": 0.5
      }
    }
  }
}
