{
  "name": "@design-parity/page-backdrop",
  "version": "0.1.24",
  "description": "Opt-in Figma page backdrops: import key pages/screens as background images, place each component instance on them, link every placement back to the code component, and view the page with the candidate renders overlaid on top.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./schema/page-backdrop.schema.json": "./schema/page-backdrop.schema.json",
    "./schema/page-backdrop-config.schema.json": "./schema/page-backdrop-config.schema.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "bin": {
    "design-parity-pages": "./dist/cli/pages.js"
  },
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run --root ../.. packages/page-backdrop/test"
  },
  "dependencies": {
    "@design-parity/core": "^0.1.24",
    "@design-parity/resolver": "^0.1.24",
    "@design-parity/adapter-figma": "^0.1.24"
  },
  "devDependencies": {
    "ajv": "8.20.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yschimke/design-parity.git",
    "directory": "packages/page-backdrop"
  },
  "homepage": "https://github.com/yschimke/design-parity/tree/main/packages/page-backdrop#readme",
  "bugs": "https://github.com/yschimke/design-parity/issues"
}
