{
  "name": "@design-parity/checks",
  "version": "0.1.9",
  "description": "Deterministic a11y + i18n spec checks over a DesignReference / CandidateRender pair. No model at run time — only committed rules and thresholds.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./schema/checks-config.schema.json": "./schema/checks-config.schema.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "bin": {
    "design-parity-validate-checks": "./dist/cli/validate-checks.js"
  },
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run"
  },
  "dependencies": {
    "@design-parity/core": "^0.1.9",
    "ajv": "^8.17.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yschimke/design-parity.git",
    "directory": "packages/checks"
  },
  "homepage": "https://github.com/yschimke/design-parity/tree/main/packages/checks#readme",
  "bugs": "https://github.com/yschimke/design-parity/issues"
}
